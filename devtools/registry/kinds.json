    {"metric": "power.draw",                           "sidebar": true, "label": "power",                         "source": "nvidia-smi query (gpu.csv)", "period_ms": 100},
    {"metric": "clocks.sm",                            "sidebar": true, "label": "SM clock",                      "source": "nvidia-smi query (gpu.csv)", "period_ms": 100},
    {"metric": "temperature.gpu",                      "sidebar": true, "label": "GPU temperature",               "source": "nvidia-smi query (gpu.csv)", "period_ms": 100},
