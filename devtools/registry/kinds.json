    {"metric": "engine.e2e_latency.count", "group": "engine", "series": "trtllm_e2e_request_latency_seconds_count",  "unit": "requests", "sidebar": false, "label": "end-to-end latency, count",    "source": "TensorRT-LLM /prometheus/metrics", "period_ms": 1000},
