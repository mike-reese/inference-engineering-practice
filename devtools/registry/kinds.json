    {"metric": "engine.tpot.count",        "group": "engine", "series": "trtllm_time_per_output_token_seconds_count","unit": "tokens",   "sidebar": false, "label": "time per output token, count", "source": "TensorRT-LLM /prometheus/metrics", "period_ms": 1000},
    {"metric": "engine.queue_time.sum",    "group": "engine", "series": "trtllm_request_queue_time_seconds_sum",     "unit": "s",        "sidebar": false, "label": "queue time, sum",              "source": "TensorRT-LLM /prometheus/metrics", "period_ms": 1000},
    {"metric": "engine.queue_time.count",  "group": "engine", "series": "trtllm_request_queue_time_seconds_count",   "unit": "requests", "sidebar": false, "label": "queue time, count",            "source": "TensorRT-LLM /prometheus/metrics", "period_ms": 1000}
  ]
}
