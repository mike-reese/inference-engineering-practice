{
 "uid": "engine",
 "title": "Engine, client and GPU",
 "schemaVersion": 39,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "5s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Engine TTFT (P50, P95)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-local"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate({__name__=~\".*time_to_first_token_seconds_bucket\"}[30s])))",
     "legendFormat": "P50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\".*time_to_first_token_seconds_bucket\"}[30s])))",
     "legendFormat": "P95"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Engine time per output token (P50)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-local"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate({__name__=~\".*time_per_output_token_seconds_bucket\"}[30s])))",
     "legendFormat": "P50"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Engine end-to-end latency (P50)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-local"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate({__name__=~\".*e2e_request_latency_seconds_bucket\"}[30s])))",
     "legendFormat": "P50"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Engine requests finished /s",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-local"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate({__name__=~\".*request_success_total\"}[30s]))",
     "legendFormat": "finished"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Client TTFT and end-to-end (P50)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-local"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(ie_client_ttft_seconds_bucket[30s])))",
     "legendFormat": "TTFT"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(ie_client_e2e_seconds_bucket[30s])))",
     "legendFormat": "e2e"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "GPU utilization and memory controller %",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-local"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "DCGM_FI_DEV_GPU_UTIL",
     "legendFormat": "SM busy"
    },
    {
     "refId": "B",
     "expr": "DCGM_FI_DEV_MEM_COPY_UTIL",
     "legendFormat": "memory busy"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "GPU memory used (MiB)",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-local"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "decmbytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "DCGM_FI_DEV_FB_USED",
     "legendFormat": "used"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "GPU power (W) and SM clock (MHz)",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-local"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "DCGM_FI_DEV_POWER_USAGE",
     "legendFormat": "power"
    },
    {
     "refId": "B",
     "expr": "DCGM_FI_DEV_SM_CLOCK",
     "legendFormat": "SM clock"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Host CPU busy %",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-local"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[10s])))",
     "legendFormat": "busy"
    }
   ]
  }
 ]
}