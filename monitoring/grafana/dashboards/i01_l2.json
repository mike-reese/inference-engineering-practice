{
  "uid": "i01-l2",
  "title": "I01-L2 chat service",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Traffic: requests/s by phase",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase) (rate(ie_client_requests_total[1m]))",
          "legendFormat": "{{phase}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Sequence lengths: mean tokens per complete request",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase) (rate(ie_client_tokens_total{direction=\"input\"}[5m])) / sum by (phase) (rate(ie_client_requests_total{outcome=\"complete\"}[5m]))",
          "legendFormat": "input {{phase}}"
        },
        {
          "refId": "B",
          "expr": "sum by (phase) (rate(ie_client_tokens_total{direction=\"output\"}[5m])) / sum by (phase) (rate(ie_client_requests_total{outcome=\"complete\"}[5m]))",
          "legendFormat": "output {{phase}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Responses / errors: finished requests by outcome",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase, outcome) (increase(ie_client_requests_total[1m]))",
          "legendFormat": "{{phase}} {{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency: client TTFT P50 / P95 by phase",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, phase) (rate(ie_client_ttft_seconds_bucket[30s])))",
          "legendFormat": "P50 {{phase}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(ie_client_ttft_seconds_bucket[30s])))",
          "legendFormat": "P95 {{phase}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency: client e2e P50 / P95 by phase",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, phase) (rate(ie_client_e2e_seconds_bucket[30s])))",
          "legendFormat": "P50 {{phase}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(ie_client_e2e_seconds_bucket[30s])))",
          "legendFormat": "P95 {{phase}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Readiness: scrape targets up",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Readiness: InferenceServerDown alert",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertname=\"InferenceServerDown\"}",
          "legendFormat": "{{alertstate}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Utilization: GPU (util %, SM clock, power, temperature)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "rotmhz"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "util GPU {{gpu}}"
        },
        {
          "refId": "B",
          "expr": "DCGM_FI_DEV_SM_CLOCK",
          "legendFormat": "SM clock GPU {{gpu}}"
        },
        {
          "refId": "C",
          "expr": "DCGM_FI_DEV_POWER_USAGE",
          "legendFormat": "power GPU {{gpu}}"
        },
        {
          "refId": "D",
          "expr": "DCGM_FI_DEV_GPU_TEMP",
          "legendFormat": "temp GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Utilization: host CPU busy and memory available",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))",
          "legendFormat": "CPU busy"
        },
        {
          "refId": "B",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "memory available"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Queue depth: server processing / deferred, client in flight",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:requests_processing",
          "legendFormat": "server processing"
        },
        {
          "refId": "B",
          "expr": "llamacpp:requests_deferred",
          "legendFormat": "server deferred"
        },
        {
          "refId": "C",
          "expr": "sum by (phase) (ie_client_in_flight)",
          "legendFormat": "client in flight {{phase}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Phase timings: engine seconds per prompt / generated token",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(llamacpp:prompt_seconds_total[5m]) / rate(llamacpp:prompt_tokens_total[5m])",
          "legendFormat": "per prompt token"
        },
        {
          "refId": "B",
          "expr": "rate(llamacpp:tokens_predicted_seconds_total[5m]) / rate(llamacpp:tokens_predicted_total[5m])",
          "legendFormat": "per generated token"
        }
      ]
    }
  ]
}
